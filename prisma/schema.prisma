// Operations Hub ("Dove Hub") data model.
//
// Prisma ORM 7 · PostgreSQL. The client is generated as TypeScript into
// `generated/prisma` (see prisma.config.ts for CLI configuration and
// lib/db.ts for the runtime client + driver adapter).
//
// Naming: model fields are camelCase and mapped to the snake_case column names
// the phase-1 types already assumed (`body_markdown`, `updated_at`, ...), so the
// data-access layer in `lib/data/*` can hand the frontend the exact shapes that
// `lib/mock-data.ts` exposes today.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------------- enums

/// Who a person is in the portal. Ordered by authority in `lib/auth.ts`
/// (`ROLE_RANK`) — `readonly` sees everything and changes nothing, `admin`
/// administers users on top of everything a clinical lead can do.
enum Role {
  admin
  clinical_lead
  author
  staff
  readonly
}

/// Article lifecycle. Extends the phase-1 `draft | published` union with the
/// optional review step; `types/portal.ts` mirrors this.
enum ArticleStatus {
  draft
  in_review
  published
}

/// **Unused since prompt 6c.** Superseded by the `pinned` / `urgent` booleans on
/// `Bulletin`; the column and this enum survive only so the existing data is not
/// migrated away. No application code reads or writes `priority`.
enum BulletinPriority {
  urgent
  pinned
  normal
}

/// Which surface a search log row came from — drives the weekly dead-search
/// review (queries that returned nothing are turned into synonyms).
enum SearchSurface {
  articles
  bulletins
  staff
}

enum ShiftPreference {
  Day
  Swing
  Overnight
}

/// Lifecycle of a self-service request for the `author` role. `pending` is open,
/// `approved` promoted the requester, `declined` closed it without a change.
enum RoleRequestStatus {
  pending
  approved
  declined
}

/// **Unused since prompt 6c.** The three-tier bulletin format was deleted; the
/// column and this enum survive only so the existing data is not migrated away.
/// No application code reads or writes `format`.
enum BulletinFormat {
  notice
  announcement
  featured
}

// --------------------------------------------------------------------- users

model User {
  id String @id @default(uuid()) @db.Uuid

  email String @unique
  /// Display name exactly as the portal renders it in `author_name`
  /// ("Trevor Lindqvist"). Combined with `title` by `lib/data/*` to reproduce
  /// the phase-1 "Name, Role" author string byte for byte.
  name  String
  /// Professional title shown after the name, e.g. "ICU Technician II".
  /// Nullable: administrative/service accounts have none.
  title String?

  role Role @default(staff)

  /// bcrypt hash for the dev Credentials provider. Nullable because
  /// IdP-authenticated accounts (OIDC/SAML) never get a local password.
  passwordHash String? @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")

  authoredArticles Article[]        @relation("ArticleAuthor")
  reviewedArticles Article[]        @relation("ArticleReviewer")
  authoredBulletins Bulletin[]
  articleVersions  ArticleVersion[]
  bulletinAcks     BulletinAck[]
  /// Bounded ❤️🎉👍 reactions this user has left on bulletins.
  bulletinReactions BulletinReaction[]
  /// Files this user attached to articles (`SetNull` when the account is removed).
  uploadedAttachments ArticleAttachment[]
  /// Files this user attached to bulletins (`SetNull` when the account is removed).
  uploadedBulletinAttachments BulletinAttachment[]

  /// Requests this user has raised (the "request author access" flow).
  roleRequests        RoleRequest[] @relation("RoleRequestRequester")
  /// Requests this user has decided (clinical leads and admins).
  decidedRoleRequests RoleRequest[] @relation("RoleRequestDecider")

  @@map("users")
}

// ------------------------------------------------------------------ articles

model Article {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique
  title String
  bodyMarkdown String @map("body_markdown")

  /// Multi-tag: a procedure routinely belongs to several departments.
  departments String[]

  status ArticleStatus @default(draft)

  authorId   String  @map("author_id") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid

  /// Required to publish (enforced in the API, not just the UI).
  effectiveDate DateTime? @map("effective_date")

  /// Import provenance (see scripts/import-mediawiki). Populated only by the
  /// MediaWiki import; null for hand-authored articles.
  sourceTitle String?   @map("source_title")
  importedAt  DateTime? @map("imported_at")

  createdAt DateTime @default(now()) @map("created_at")
  /// Managed explicitly by `lib/data/articles.ts` on every write rather than by
  /// Prisma's `@updatedAt`, so the seed can preserve the phase-1 fixture
  /// timestamps and the API can be explicit about when a row changed.
  updatedAt DateTime @map("updated_at")

  author   User   @relation("ArticleAuthor", fields: [authorId], references: [id])
  reviewer User?  @relation("ArticleReviewer", fields: [reviewerId], references: [id])
  versions ArticleVersion[]
  bulletins Bulletin[]
  attachments ArticleAttachment[]

  @@index([status])
  @@index([updatedAt(sort: Desc)])
  @@map("articles")
}

/// Immutable publish history. A row is written on every transition to
/// `published` and is never updated or deleted — a database trigger
/// (see prisma/migrations) enforces that in addition to the API never
/// exposing an update/delete path.
model ArticleVersion {
  id        String @id @default(uuid()) @db.Uuid
  articleId String @map("article_id") @db.Uuid

  /// Sequential per article, starting at 1.
  version Int

  title         String
  bodyMarkdown  String @map("body_markdown")
  changeSummary String @map("change_summary")

  changedById String   @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@unique([articleId, version])
  @@index([articleId, createdAt(sort: Desc)])
  @@map("article_versions")
}

// ----------------------------------------------------------------- bulletins

model Bulletin {
  id String @id @default(uuid()) @db.Uuid

  title        String
  bodyMarkdown String @map("body_markdown")
  departments  String[]

  /// Pinned: floats to the top of every board and renders as the dark
  /// calling-card hero (detail) / dark mini-card (board rail).
  pinned Boolean @default(false)
  /// Urgent: an opt-in red visual flag. Not a tier — just a chip.
  urgent Boolean @default(false)

  /// The muted subtitle line under the headline (plain text). Optional, whole
  /// life of the post.
  deck String?

  /// An optional hero banner image rendered above the headline, whatever the
  /// post. `https://` URL or a relative portal path; null = no hero.
  heroImageUrl String? @map("hero_image_url")
  /// Required whenever `heroImageUrl` is set (max 280 chars), rendered as the
  /// `<img alt>`.
  heroImageAlt String? @map("hero_image_alt")

  linkedArticleId String? @map("linked_article_id") @db.Uuid

  authorId String @map("author_id") @db.Uuid

  /// When the notice went up. Exposed to the frontend as `created_at`.
  publishedAt DateTime @map("published_at")

  /// Opt-in expiry. On board fetch, rows with `expiresAt <= now()` are silently
  /// deleted. Null = the post lives until it is manually deleted.
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // --- Legacy columns (prompt 6c). Left in place, never read or written by the
  //     application; the data is preserved rather than migrated away. ---
  /// Unused. Superseded by `pinned` / `urgent`.
  priority BulletinPriority @default(normal)
  /// Unused. The presentation tier was deleted.
  format BulletinFormat @default(notice)
  /// Unused. The eyebrow pill was deleted (departments are the tags).
  kicker String?

  linkedArticle Article? @relation(fields: [linkedArticleId], references: [id], onDelete: SetNull)
  author        User     @relation(fields: [authorId], references: [id])
  acks          BulletinAck[]
  reactions     BulletinReaction[]
  /// Files attached to this notice (PDF / DOCX / XLSX / PPTX / TXT / CSV).
  attachments   BulletinAttachment[]

  @@index([publishedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("bulletins")
}

/// "Who has seen this critical alert." One row per (bulletin, user); the ack
/// endpoint is idempotent.
model BulletinAck {
  id String @id @default(uuid()) @db.Uuid

  bulletinId String @map("bulletin_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  ackedAt    DateTime @default(now()) @map("acked_at")

  bulletin Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, userId])
  @@index([bulletinId])
  @@map("bulletin_acks")
}

/// A bounded reaction on a bulletin: one row per (bulletin, user, emoji).
///
/// The emoji is validated against the fixed allowlist (`❤️` `🎉` `👍`) in
/// `lib/bulletin/reactions.ts` before the row is written; the unique constraint
/// is what makes a rapid double-toggle idempotent — the write path inserts and
/// treats a P2002 as "already reacted, so delete it" (toggle off).
model BulletinReaction {
  id String @id @default(uuid()) @db.Uuid

  bulletinId String @map("bulletin_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  bulletin Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, userId, emoji])
  @@index([bulletinId])
  @@map("bulletin_reactions")
}

/// A file attached to an article (PDF / DOCX / XLSX).
///
/// Attachments belong to the article, not to a version, so they persist across
/// republication and the reader lists them on the current version. The object
/// key is server-derived (`attachments/<uuid>/<sanitized-fileName>`) and is
/// never exposed to the client — the reader streams through the API instead.
model ArticleAttachment {
  id String @id @default(uuid()) @db.Uuid

  articleId String @map("article_id") @db.Uuid
  fileName  String @map("file_name")
  fileKey   String @map("file_key")
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  /// Nullable: removing the uploader's account must not delete the article's
  /// attachments, so the FK is `SetNull` rather than `Cascade`.
  uploadedById String? @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@map("article_attachments")
}

/// A file attached to a bulletin (PDF / DOCX / XLSX / PPTX / TXT / CSV).
///
/// The bulletin counterpart of `ArticleAttachment`, and deliberately identical
/// in shape and semantics: the file belongs to the bulletin — not to any edit
/// of it — so it survives every later save, the object key is server-derived
/// (`attachments/<uuid>/<sanitized-fileName>`) and never crosses the wire (the
/// reader streams through the API), and the uploader FK is `SetNull` so
/// removing an account never removes a notice's files.
///
/// **`bulletinId` is nullable, and that is the staging mechanism.** A composer
/// writing a *new* notice has no id to attach to yet, so a file chosen before
/// the first save is stored with `bulletinId = null` ("staged") and linked to
/// the bulletin when it is created — the same shape as the hero image, which is
/// uploaded immediately and referenced by URL in the saved payload. A staged
/// row that is never linked is swept after `STAGED_ATTACHMENT_TTL_MS`
/// (`lib/bulletin/lifecycle.ts`): its object is deleted from storage and then
/// the row itself. `Cascade` on the bulletin FK still means a deleted notice
/// takes its linked attachments with it.
model BulletinAttachment {
  id String @id @default(uuid()) @db.Uuid

  /// Null while the attachment is staged for a bulletin that does not exist yet.
  bulletinId String? @map("bulletin_id") @db.Uuid
  fileName   String  @map("file_name")
  fileKey    String  @map("file_key")
  mimeType   String  @map("mime_type")
  sizeBytes  Int     @map("size_bytes")

  /// Nullable: removing the uploader's account must not delete the bulletin's
  /// attachments, so the FK is `SetNull` rather than `Cascade`.
  uploadedById String? @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  bulletin   Bulletin? @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([bulletinId])
  @@index([bulletinId, createdAt])
  @@map("bulletin_attachments")
}

// ----------------------------------------------------------- role requests

/// A staff member's self-service request for the `author` role.
///
/// The row records *who asked* and *who decided*, never a client-supplied
/// target role beyond the single permitted value: `requestedRole` is written
/// as `author` by the API and its client never sets it. Promotion happens by
/// updating `User.role` on approval — there is no self-promotion path, and no
/// request can ever name `clinical_lead` or `admin`.
model RoleRequest {
  id String @id @default(uuid()) @db.Uuid

  userId        String @map("user_id") @db.Uuid
  /// Always `author` today; a column rather than a literal so the flow can
  /// grow without a schema change, while `lib/role-requests.ts` keeps the
  /// endpoint pinned to the one value it will accept.
  requestedRole Role   @default(author) @map("requested_role")

  status RoleRequestStatus @default(pending)

  /// Free-text note attached when the request is decided (a decline reason, or
  /// an approval remark). Null while the request is open.
  note String?

  decidedById String?   @map("decided_by_id") @db.Uuid
  decidedAt   DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")

  user      User  @relation("RoleRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("RoleRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("role_requests")
}

// --------------------------------------------------------------------- staff

model StaffMember {
  id String @id @default(uuid()) @db.Uuid

  systemId      String @unique @map("system_id")
  fullName      String @map("full_name")
  preferredName String @map("preferred_name")
  pronouns      String
  title         String
  departments   String[]

  email          String @unique
  phoneExtension String @map("phone_extension")
  directPhone    String @map("direct_phone")

  shiftPreference ShiftPreference @map("shift_preference")
  /// `ShiftRotation[]` — label / days / hours.
  shiftRotations  Json            @map("shift_rotations")

  avatarUrl String? @map("avatar_url")

  @@index([fullName])
  @@map("staff_members")
}

// ------------------------------------------------------------------- logging

model SearchLog {
  id String @id @default(uuid()) @db.Uuid

  query       String
  resultCount Int           @map("result_count")
  surface     SearchSurface
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([resultCount])
  @@map("search_logs")
}
